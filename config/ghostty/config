title = terminal
command = /usr/bin/fish
shell-integration = fish
gtk-single-instance = desktop
quit-after-last-window-closed = true
scrollback-limit = 100000000

foreground = D8DEE9
background = 2E3440
background-opacity = 0.95  
background-blur = 10   
cursor-style = block

window-padding-x = 5
window-decoration = auto
window-theme = dark

font-family = "Source Code Pro"
font-family-bold = "Source Code Pro Bold"
font-family-italic = "Source Code Pro Italic Italic"
font-family-bold-italic = "Source Code Pro Italic Bold Italic"
font-style = Regular
font-size = 14

# clipboard 
clipboard-read = ask 
clipboard-write = allow 
clipboard-paste-protection = true 
copy-on-select = true 

# custom keybinds
keybind = ctrl+s=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+f=toggle_fullscreen
keybind = alt+ctrl+equal=equalize_splits
keybind = shift+alt+ctrl+up=resize_split:up,10
keybind = shift+alt+ctrl+down=resize_split:down,10
keybind = shift+alt+ctrl+right=resize_split:right,10
keybind = shift+alt+ctrl+left=resize_split:left,10

# unbind default keybinds
keybind = super+d=unbind
keybind = super+alt+up=unbind
keybind = super+alt+down=unbind
keybind = super+alt+left=unbind
keybind = super+alt+right=unbind
keybind = super+alt+f=unbind
keybind = super+ctrl+f=unbind
keybind = super+enter=unbind
keybind = super+ctrl+equal=unbind
keybind = super+ctrl+up=unbind
keybind = super+ctrl+down=unbind
keybind = super+ctrl+right=unbind
keybind = super+ctrl+left=unbind
